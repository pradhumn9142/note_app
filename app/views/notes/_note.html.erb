<div id="<%= dom_id note %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= note.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Content:</strong>
    <%= note.content %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is pinned:</strong>
    <%= note.is_pinned? ? "Yes" : "No" %>
  </div>
</div>
